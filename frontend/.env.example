# Local: point Vite at the local FastAPI. Production APK/web uses .env.production.
VITE_API_URL=http://127.0.0.1:8000/api/v1

# Sentry (frontend public DSN)
VITE_SENTRY_DSN=""

# Supabase (anon / publishable key only — never service role)
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY=""
