# Application Settings
PROJECT_NAME="Aile Uygulaması"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# CORS (Frontend URL list separated by commas)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,capacitor://localhost,http://localhost"

# Database Connection (PostgreSQL / Supabase connection pool or direct URL)
# Example: postgresql://postgres.xxxx:password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DATABASE_URL="sqlite:///./family_app.db"

# Supabase Credentials (Optional for direct Supabase Auth and Storage integration)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"

# Local / Standalone JWT settings (used if standalone token verification is desired)
SECRET_KEY="supersecretfamilyappjwtkeychangeinproduction"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=43200 # 30 days for mobile family convenience

# Storage Bucket
STORAGE_BUCKET_NAME="family-media"
