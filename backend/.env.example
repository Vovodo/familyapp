# Application Settings
PROJECT_NAME="Aile Uygulaması"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# CORS
CORS_ORIGINS="https://family.rfqcollector.com,http://localhost:5173,http://localhost:3000,capacitor://localhost,http://localhost"

# Copy this file to backend/.env (gitignored) and fill real values.
# Do not put secrets in this example file.
DATABASE_URL="sqlite:///./family_app.db"

# Supabase
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_JWT_SECRET=""
STORAGE_BUCKET_NAME="family-media"

# Sentry (backend project)
SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"

# Security & JWT
SECRET_KEY="change-me-in-local-env"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Resend
RESEND_API_KEY=""
EMAIL_FROM="Ailem <bildirim@rfqcollector.com>"

# Default Admin Seed
ADMIN_EMAIL="admin@aile.com"
ADMIN_PASSWORD="Admin1234!*"
ADMIN_NAME="Sistem Yöneticisi (Ege)"

